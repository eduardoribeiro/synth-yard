{
  "name": "synth-yard",
  "version": "1.0.0",
  "description": "Open-source, self-hosted 3D printer fleet management",
  "author": "Eduardo Ribeiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoribeiro/synth-yard.git"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "keywords": [
    "3d-printing",
    "print-farm",
    "printer-fleet",
    "synth-yard",
    "prusa",
    "bambu",
    "klipper",
    "elegoo",
    "self-hosted"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run server\" \"pnpm run client\"",
    "server": "node server/index.js",
    "client": "pnpm --dir client dev",
    "build": "pnpm --dir client build",
    "start": "node server/index.js",
    "test": "jest --testPathPatterns=server/tests"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "basic-ftp": "^5.2.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^8.2.2",
    "express": "^4.19.2",
    "form-data": "^4.0.5",
    "mqtt": "^5.15.1",
    "multer": "^2.2.0",
    "papaparse": "^5.4.1",
    "sdcp": "^0.5.4"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4"
}
